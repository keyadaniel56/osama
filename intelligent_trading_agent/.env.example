"""
Environment configuration template for the Intelligent Trading Agent.
Copy this file to .env and fill in your actual values.
"""

# Deriv API Configuration
DERIV_API_TOKEN=your_api_token_here
DERIV_APP_ID=1089

# Trading Configuration
SYMBOL=R_100
STAKE=1.0
TAKE_PROFIT=10.0
STOP_LOSS=5.0

# Risk Management
MAX_DAILY_LOSS=10.0
MAX_CONSEC_LOSSES=3
MAX_DRAWDOWN=20.0

# Agent Behavior
MIN_CONFIDENCE=0.60
HIGH_CONFIDENCE=0.75
ULTRA_CONFIDENCE=0.85
MIN_MARKET_HEALTH=50

# Logging
LOG_LEVEL=INFO

# Feature Engineering
FEATURE_WINDOW=30
NUM_FEATURES=50

# Model Training
RETRAIN_EVERY=50
CONTINUOUS_LEARNING=True

# Market Analysis
MARKET_STATE_WINDOW=100
VOLATILITY_THRESHOLD_HIGH=0.75
VOLATILITY_THRESHOLD_LOW=0.25
